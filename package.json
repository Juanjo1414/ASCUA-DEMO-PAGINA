{
  "name": "ascua-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/build-content.ts",
    "build:e2e": "vite build --outDir dist-e2e && tsx scripts/build-content.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173",
    "prepare": "husky",
    "arch:check": "depcruise src",
    "content:validate": "tsx scripts/validate-content.ts",
    "licenses:check": "license-checker --production --failOn \"GPL;AGPL\"",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run content:validate && npm run arch:check && npm run licenses:check && npm run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "dependency-cruiser": "^18.8.0",
    "ffmpeg-static": "^5.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  }
}
